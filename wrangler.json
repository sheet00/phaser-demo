/**
 * Cloudflare Workers (Assets) 用 Wrangler 設定
 */
{
  "$schema": "src/node_modules/wrangler/config-schema.json",
  "name": "phaser-demo",
  "main": "src/dominion-worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./src/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DOMINION_ROOMS", "class_name": "DominionRoom" }]
  },
  "migrations": [{ "tag": "dominion-v1", "new_sqlite_classes": ["DominionRoom"] }],
  "observability": {
    "enabled": true
  }
}
